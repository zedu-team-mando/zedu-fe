# Copy this file to `.env` and fill in your team's values.
# Never commit `.env` or any real value.
#
# Named `env.example` (not `.env.example`) because the repo's file policy blocks
# any `.env.*` file.

# --- Required for most local development ---

# REST API (src/utils/new-request.ts, src/utils/request.ts)
NEXT_PUBLIC_BASE_URL=https://api.staging.zedu.chat/api/v1

# Public frontend URL (links, redirects, Centrifugo layout)
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# Centrifugo WebSocket (src/components/layout/centrifugo/*)
NEXT_PUBLIC_CONNECT_URL=wss://<host>/connection/websocket

# OAuth (src/app/(auth)/layout.tsx, sign-up, invitation layouts)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-client-id>
NEXT_PUBLIC_APPLE_CLIENT_ID=<apple-client-id>

# Buzz / Agora client (src/lib/agora/config.ts)
NEXT_PUBLIC_AGORA_APP_ID=<agora-app-id>

# --- Optional / feature-specific ---

# REST API used by Buzz route layout
NEXT_PUBLIC_API_URL=https://api.staging.zedu.chat/api/v1

# Google Analytics (src/app/layout.tsx)
NEXT_PUBLIC_GA_ID=<google-analytics-id>

# OneSignal push (src/lib/onesignal/init.ts)
NEXT_PUBLIC_ONESIGNAL_APP_ID=<onesignal-app-id>

# Web Push VAPID keys (src/lib/push.ts)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
NEXT_PUBLIC_VAPID_PRIVATE_KEY=<vapid-private-key>

# Integration API — src/utils/request.ts Integration* helpers
NEXT_PUBLIC_INTEGRATION_URL=<integration-api-url>

# Analytics webhooks — src/utils/webhook-request.ts
NEXT_PUBLIC_REGISTER_WEBHOOK_URL=<url>
NEXT_PUBLIC_LOGIN_WEBHOOK_URL=<url>
NEXT_PUBLIC_PAGE_VISIT_WEBHOOK_URL=<url>
NEXT_PUBLIC_SUCCESS_WEBHOOK_URL=<url>
NEXT_PUBLIC_ERROR_WEBHOOK_URL=<url>

# Homepage footer social links (src/app/(homepage)/_components/footer).
# Read at build time: rebuild after changing them.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/telex.im
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@telexim
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1CyRjZC3rz/
NEXT_PUBLIC_X_URL=https://x.com/teleximapp

# --- Server-only (Next.js API routes; never exposed to the browser) ---

# Agora server token route (src/app/api/agora/token/route.ts)
AGORA_APP_ID=<agora-app-id>
AGORA_APP_CERTIFICATE=<agora-certificate>
