    "start": "node api.js && next start",
    "prepare": "husky",
    "postinstall": "node -e \"if (process.platform !== 'win32') require('child_process').execSync('chmod +x .husky/*', { stdio: 'inherit' })\"",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "pre-commit": "lint-staged --concurrent false",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint ./src",
    "format": "prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm run build",
    "commitlint": "commitlint",
    "commitlint:check": "commitlint --from origin/main --to HEAD --verbose",
    "pr-review:check": "node .github/scripts/pr-review/run.mjs --base origin/main --head HEAD --config .github/pr-review.config.json --output review-report.json",
    "security:audit": "pnpm audit --audit-level high",
    "security:files": "bash .github/scripts/verify-changed-files.sh origin/main HEAD",
    "security:malware": "node .github/scripts/scan-malware.mjs",
    "email": "email dev --dir src/emails",
    "cypress": "cypress open"
